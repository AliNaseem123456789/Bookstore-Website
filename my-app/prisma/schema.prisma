// Al-Sehar Bookstore — data model
//
// Design rules this schema enforces:
//  1. `items.quantity_on_hand` is NEVER written by application code. It is
//     maintained exclusively by a trigger on `stock_movements`, so the ledger
//     and the cached quantity can never disagree. See migration.sql.
//  2. Stock can never go negative (CHECK + trigger). Overselling is recorded
//     as `sale_lines.qty_backordered`, never as negative stock.
//  3. Sale money totals (`balance_due`, `payment_status`) are maintained by
//     triggers from the payment and return ledgers — not by the app.
//  4. Everything financial is append-only. Nothing is ever edited in place:
//     payments, returns and stock movements are all immutable rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum Role {
  ADMIN // everything: users, prices, curriculum, corrections, audit
  MANAGER // restock, fulfil backorders, refunds, all sales, analytics
  CASHIER // sell, take payments, see own sales
}

enum ItemType {
  BOOK
  COPY
  STATIONERY
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  REFUND_CASH // negative amounts only: money handed back to the buyer
  WRITE_OFF // negative-balance forgiveness, admin only
}

enum MovementReason {
  OPENING // opening balance at system go-live
  RESTOCK // new stock received
  SALE // sold and handed over at the counter
  BACKORDER_FULFILL // previously backordered, handed over now
  RETURN_RESELLABLE // came back in saleable condition
  WRITE_OFF // damaged / lost / returned unsaleable
  CORRECTION // admin stock-count adjustment
}

enum ReturnCondition {
  RESELLABLE
  DAMAGED
}

// ---------------------------------------------------------------- people

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         Role     @default(CASHIER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sales            Sale[]           @relation("sold_by")
  paymentsReceived Payment[]        @relation("received_by")
  movements        StockMovement[]  @relation("movement_actor")
  returns          SaleReturn[]     @relation("return_actor")
  auditEntries     AuditLog[]       @relation("audit_actor")

  @@index([role, isActive])
  @@map("users")
}

// ---------------------------------------------------------------- catalogue

model Class {
  id        Int    @id @default(autoincrement())
  code      String @unique // NUR, KG1, KG2, G1 … G10
  name      String // "Nursery", "Class 1"
  sortOrder Int    @unique @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  curriculumItems  CurriculumItem[]
  electiveGroups   ElectiveGroup[]
  saleLines        SaleLine[]

  @@map("classes")
}

/// One physical thing the shop sells. `quantity_on_hand` is trigger-maintained.
model Item {
  id             Int      @id @default(autoincrement())
  code           String   @unique // human/scannable: BK-0001, CP-0012
  name           String
  normalizedName String   @map("normalized_name") // lowercased, punctuation stripped
  publisher      String?
  type           ItemType @default(BOOK)
  price          Decimal  @db.Decimal(12, 2)
  quantityOnHand Int      @default(0) @map("quantity_on_hand")
  reorderLevel   Int      @default(10) @map("reorder_level")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  aliases         ItemAlias[]
  curriculumItems CurriculumItem[]
  saleLines       SaleLine[]
  movements       StockMovement[]
  priceHistory    PriceHistory[]

  @@index([normalizedName])
  @@index([type, isActive])
  @@map("items")
}

/// Alternate names staff actually type, so one book is never entered twice.
model ItemAlias {
  id              Int    @id @default(autoincrement())
  itemId          Int    @map("item_id")
  alias           String
  normalizedAlias String @unique @map("normalized_alias")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_aliases")
}

model PriceHistory {
  id            Int      @id @default(autoincrement())
  itemId        Int      @map("item_id")
  oldPrice      Decimal  @map("old_price") @db.Decimal(12, 2)
  newPrice      Decimal  @map("new_price") @db.Decimal(12, 2)
  changedById   Int?     @map("changed_by_id")
  changedAt     DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, changedAt])
  @@map("price_history")
}

// ---------------------------------------------------------------- curriculum

/// A choice bucket inside one class's course, e.g. "pick exactly 1 of
/// Biology / Computer" for Class 9. Fully data-driven: change min/max or add
/// a second group without touching code.
model ElectiveGroup {
  id        Int    @id @default(autoincrement())
  classId   Int    @map("class_id")
  groupKey  String @map("group_key") // SCIENCE_ELECTIVE
  label     String // "Science elective"
  minSelect Int    @default(1) @map("min_select")
  maxSelect Int    @default(1) @map("max_select")

  class           Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  curriculumItems CurriculumItem[]

  @@unique([classId, groupKey])
  @@map("elective_groups")
}

/// Membership of an item in a class's course. Replaces both the old
/// `class_item_map` and `course_defaults` (default qty lives here now, so no
/// more runtime name-pattern matching).
model CurriculumItem {
  id              Int     @id @default(autoincrement())
  classId         Int     @map("class_id")
  itemId          Int     @map("item_id")
  defaultQty      Int     @default(1) @map("default_qty")
  electiveGroupId Int?    @map("elective_group_id") // null => mandatory
  sortOrder       Int     @default(0) @map("sort_order")

  class         Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  item          Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  electiveGroup ElectiveGroup? @relation(fields: [electiveGroupId], references: [id], onDelete: SetNull)

  @@unique([classId, itemId])
  @@index([classId, sortOrder])
  @@map("curriculum_items")
}

// ---------------------------------------------------------------- selling

/// One checkout = one Sale, however many classes or loose items it contains.
/// (The old schema wrote one `course_sales` row per class and stitched them
/// back together with a text `transaction_id`.)
model Sale {
  id           Int        @id @default(autoincrement())
  code         String     @unique // S-2026-000123
  buyerName    String     @map("buyer_name")
  buyerPhone   String?    @map("buyer_phone")
  soldByUserId Int        @map("sold_by_user_id")
  status       SaleStatus @default(COMPLETED)

  // Money. All trigger-maintained except the first three, which are written
  // once at checkout and never change.
  subtotal      Decimal @db.Decimal(12, 2) // sum of line totals before discounts
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(12, 2)
  grossTotal    Decimal @map("gross_total") @db.Decimal(12, 2) // owed at sale time

  returnCredit  Decimal @default(0) @map("return_credit") @db.Decimal(12, 2) // credited back by returns
  amountReceived Decimal @default(0) @map("amount_received") @db.Decimal(12, 2) // sum of positive payments
  amountRefunded Decimal @default(0) @map("amount_refunded") @db.Decimal(12, 2) // sum of negative payments, abs
  balanceDue    Decimal @default(0) @map("balance_due") @db.Decimal(12, 2) // (gross - credit) - received + refunded
  isSettled     Boolean @default(false) @map("is_settled")

  note      String?
  soldAt    DateTime @default(now()) @map("sold_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  soldBy  User         @relation("sold_by", fields: [soldByUserId], references: [id])
  lines   SaleLine[]
  payments Payment[]
  returns SaleReturn[]

  @@index([soldAt])
  @@index([soldByUserId, soldAt])
  @@index([isSettled, soldAt])
  @@index([buyerName])
  @@map("sales")
}

model SaleLine {
  id       Int    @id @default(autoincrement())
  saleId   Int    @map("sale_id")
  itemId   Int    @map("item_id")

  // Snapshots: history must not change when the catalogue does.
  itemNameSnapshot String  @map("item_name_snapshot")
  unitPrice        Decimal @map("unit_price") @db.Decimal(12, 2)

  qty          Int
  lineDiscount Decimal @default(0) @map("line_discount") @db.Decimal(12, 2)
  lineTotal    Decimal @map("line_total") @db.Decimal(12, 2)

  qtyDelivered   Int @default(0) @map("qty_delivered")
  qtyBackordered Int @default(0) @map("qty_backordered")
  qtyReturned    Int @default(0) @map("qty_returned")

  // Provenance: which class course this line came from, if any.
  classId          Int?    @map("class_id")
  fromFullCourse   Boolean @default(false) @map("from_full_course")

  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item        Item         @relation(fields: [itemId], references: [id])
  class       Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  returnLines ReturnLine[]

  @@index([saleId])
  @@index([itemId])
  @@index([qtyBackordered])
  @@map("sale_lines")
}

/// Signed cash ledger for one sale. Positive = money in. Negative = money
/// handed back. Never updated, never deleted.
model Payment {
  id               Int           @id @default(autoincrement())
  saleId           Int           @map("sale_id")
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod @default(CASH)
  receivedByUserId Int           @map("received_by_user_id")
  returnId         Int?          @map("return_id") // set when this is a refund payout
  note             String?
  receivedAt       DateTime      @default(now()) @map("received_at") @db.Timestamptz(6)

  sale       Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  receivedBy User        @relation("received_by", fields: [receivedByUserId], references: [id])
  return     SaleReturn? @relation(fields: [returnId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([receivedAt])
  @@index([receivedByUserId, receivedAt])
  @@map("payments")
}

// ---------------------------------------------------------------- returns

model SaleReturn {
  id            Int      @id @default(autoincrement())
  code          String   @unique // R-2026-000045
  saleId        Int      @map("sale_id")
  createdById   Int      @map("created_by_id")
  reason        String?
  creditTotal   Decimal  @default(0) @map("credit_total") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sale      Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  createdBy User         @relation("return_actor", fields: [createdById], references: [id])
  lines     ReturnLine[]
  payouts   Payment[]

  @@index([saleId])
  @@index([createdAt])
  @@map("sale_returns")
}

model ReturnLine {
  id           Int             @id @default(autoincrement())
  returnId     Int             @map("return_id")
  saleLineId   Int             @map("sale_line_id")
  qty          Int
  refundAmount Decimal         @map("refund_amount") @db.Decimal(12, 2)
  condition    ReturnCondition @default(RESELLABLE)

  return   SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleLine SaleLine   @relation(fields: [saleLineId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([saleLineId])
  @@map("return_lines")
}

// ---------------------------------------------------------------- stock ledger

/// The single source of truth for stock. Append-only: a trigger applies
/// `delta` to `items.quantity_on_hand`, stamps `balance_after`, and refuses
/// anything that would drive stock below zero. UPDATE and DELETE are blocked.
model StockMovement {
  id              Int            @id @default(autoincrement())
  itemId          Int            @map("item_id")
  delta           Int // negative = out of stock, positive = into stock
  reason          MovementReason
  refType         String?        @map("ref_type") // "sale", "return", "restock_batch"
  refId           Int?           @map("ref_id")
  balanceAfter    Int            @map("balance_after") // stamped by the trigger
  createdByUserId Int?           @map("created_by_user_id")
  note            String?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  item      Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdBy User? @relation("movement_actor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
  @@index([reason, createdAt])
  @@index([refType, refId])
  @@map("stock_movements")
}

/// Groups one "stock received" action so the history reads as batches.
model RestockBatch {
  id          Int      @id @default(autoincrement())
  code        String   @unique // RS-2026-000012
  receivedById Int     @map("received_by_id")
  supplier    String?
  note        String?
  totalUnits  Int      @default(0) @map("total_units")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("restock_batches")
}

// ---------------------------------------------------------------- plumbing

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int?     @map("actor_user_id")
  action      String // SALE_CREATED, PAYMENT_RECEIVED, PRICE_CHANGED …
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  summary     String?
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("audit_actor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}

/// Makes every mutating endpoint safe to retry. A double-tapped Confirm
/// button or a network retry replays the stored response instead of
/// creating a second sale.
model IdempotencyKey {
  key         String   @id
  endpoint    String
  requestHash String   @map("request_hash")
  statusCode  Int      @map("status_code")
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("idempotency_keys")
}
